# Target and memory
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# CPU and scheduler
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Core affinity: everything asynchronous lives on Core 0
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Console: UART0 primary, native USB Serial/JTAG secondary (both print logs)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Safety layers
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_TASK_WDT_EN=y

# IRAM-safe peripheral control (the flight loop must survive cache stalls)
CONFIG_I2C_ISR_IRAM_SAFE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Wi-Fi (M5, blueprint section 4.9): IRAM optimisations
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# No flash writes at runtime (M5): Wi-Fi config stays in RAM, PHY calibration is not stored
# in NVS (full calibration at every boot), so NVS is never initialised
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# LittleFS reads through the cache-mapped partition instead of esp_flash_read(), which would
# disable the cache on both cores for every read (M5)
CONFIG_LITTLEFS_MMAP_PARTITION=y

# WebSocket on the HTTP server (M6, blueprint section 4.6): the browser control and ping
# endpoint "/ws"
CONFIG_HTTPD_WS_SUPPORT=y

# MCPWM compare setter in IRAM (M7a, blueprint 4.9): hal_mcpwm::set_all_permille() is called from
# the Core 1 flight task and must be IRAM-safe. (The blueprint's CONFIG_MCPWM_ISR_IRAM_SAFE is
# CONFIG_MCPWM_ISR_CACHE_SAFE in IDF 5.5.3 and is not needed: no MCPWM interrupts are used.)
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y

# M7b watchdogs (decisions D1, D1b; blueprint 4.2, 4.8). Interrupt watchdog 100 ms with the CPU1
# tick watched: covers a Core 1 hang with interrupts masked, which the Core 1 GPTimer watchdog
# cannot see. Task watchdog 2 s with panic (without it a task watchdog timeout only prints),
# watching IDLE1 (IDLE0 not watched since M7c, below). Panics print the backtrace and reboot; the
# panic wrapper in hal_mcpwm forces the gates low first.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=100
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
# IDLE0 not watched (M7c, B-M7c-08): page serving keeps Core 0 busy for more than 2 s with nothing
# wrong, and a panic reset is itself a hazard in flight. Core 0 starvation of the flight path is
# covered by the 150 ms link-loss cut on Core 1. IDLE1 (the flight core) stays watched with panic.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# GPTimer default ISR in IRAM (the IDF default, set explicitly for the watchdog)
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
# Watchdog interrupt allocated with ESP_INTR_FLAG_IRAM, so it keeps running while the flash cache
# is disabled (M7b: up to 902 us late while DISARMED without it). The callback and all it touches
# must be in IRAM/DRAM. Verify against IDF docs (gptimer Kconfig, 5.5.3).
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
# IMU I2C transfer path in IRAM (M7c R5 result (b), B-M7c-11): the IDF i2c_master object, hal_i2c and
# drv_mpu6500 through components/hal_i2c/linker.lf. Burst average under page serving 620 -> 479 us,
# worst frame 783 -> 553 us; +7.4 KB internal RAM.
CONFIG_FE_R5_I2C_IRAM=y
# FreeRTOS timer service task ("Tmr Svc") pinned to Core 0: unpinned it may run on Core 1 (M7b)
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
