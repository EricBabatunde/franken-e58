# Target and memory
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# CPU and scheduler
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Core affinity: everything asynchronous lives on Core 0
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Console: UART0 primary, native USB Serial/JTAG secondary (both print logs)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Safety layers
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_TASK_WDT_EN=y

# IRAM-safe peripheral control (the flight loop must survive cache stalls)
CONFIG_I2C_ISR_IRAM_SAFE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Wi-Fi (M5, blueprint section 4.9): IRAM optimisations
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# No flash writes at runtime (M5): Wi-Fi config stays in RAM, PHY calibration is not stored
# in NVS (full calibration at every boot), so NVS is never initialised
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# LittleFS reads through the cache-mapped partition instead of esp_flash_read(), which would
# disable the cache on both cores for every read (M5)
CONFIG_LITTLEFS_MMAP_PARTITION=y

# WebSocket on the HTTP server (M6, blueprint section 4.6): the browser control and ping
# endpoint "/ws"
CONFIG_HTTPD_WS_SUPPORT=y

# MCPWM compare setter in IRAM (M7a, blueprint 4.9): hal_mcpwm::set_all_permille() is called from
# the Core 1 flight task and must be IRAM-safe. (The blueprint's CONFIG_MCPWM_ISR_IRAM_SAFE is
# CONFIG_MCPWM_ISR_CACHE_SAFE in IDF 5.5.3 and is not needed: no MCPWM interrupts are used.)
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
